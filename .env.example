# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_CORS_ORIGIN=*

# Firebase Credentials (from Firebase Console -> Project Settings -> Service Accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web API Key (from Firebase Console -> Project Settings -> General -> Web API Key)
FIREBASE_WEB_API_KEY=

# Default Trial Duration in Days
DEFAULT_TRIAL_DAYS=14

# Super Admin Credentials
SUPER_ADMIN_EMAIL=admin@stockforge.io
SUPER_ADMIN_PASSWORD=SuperAdmin@StockForge2026!
SUPER_ADMIN_NAME="Super Administrator"
