# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_CORS_ORIGIN=*

# JWT Secret (for fallback authentication / session token)
JWT_SECRET=stockforge_super_secure_jwt_secret_dev_2026_change_in_production
JWT_EXPIRES_IN=7d

# Firebase Admin Configuration
# Option 1: Path to Firebase Service Account JSON file (recommended)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option 2: Individual credentials from Firebase Service Account JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Option 3: Firebase Web API Key (Used to verify email/password logins with Firebase Auth REST API)
# Found in Firebase Console -> Project Settings -> General -> Web API Key
FIREBASE_WEB_API_KEY=

# Default Trial Duration in Days
DEFAULT_TRIAL_DAYS=14

